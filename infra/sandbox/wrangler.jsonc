{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rokan-sandbox",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "RokanSandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "RokanSandbox", "name": "Sandbox" },
      { "class_name": "Gate", "name": "Gate" }
    ]
  },
  "migrations": [{ "new_sqlite_classes": ["RokanSandbox", "Gate"], "tag": "v1" }],
  "vars": {
    "APP_ORIGIN": "https://rokan-terminal.vercel.app",
    "SESSION_TTL_MS": "1800000",
    "SESSIONS_PER_IP_PER_10MIN": "1",
    "MAX_CONCURRENT_PER_IP": "3"
  },
  "observability": { "enabled": true }
}
