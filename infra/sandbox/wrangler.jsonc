{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rokan-sandbox",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "RokanSandbox",
      "image": "./Dockerfile.rokan",
      "instance_type": "basic",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "RokanSandbox", "name": "Sandbox" },
      { "class_name": "Gate", "name": "Gate" }
    ]
  },
  "migrations": [{ "new_sqlite_classes": ["RokanSandbox", "Gate"], "tag": "v1" }],
  "vars": {
    "APP_ORIGIN": "https://rokan-terminal.vercel.app",
    "SESSION_TTL_MS": "1800000",
    // TESTING caps — raised so the builder can run many --judge checks from one IP without hitting the
    // per-IP limit. REVERT BOTH TO "3" BEFORE THE FREEZE (the 3/3 cap is the stranger-abuse story in
    // docs/SECURITY.md). TTL stays 30 min so a judge session is unaffected. Tracked in docs/PROGRESS.md.
    "SESSIONS_PER_IP_PER_10MIN": "50",
    "MAX_CONCURRENT_PER_IP": "20"
  },
  "observability": { "enabled": true }
}
