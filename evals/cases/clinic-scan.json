[
 {
  "_doc": [
   "clinic-scan — a person with two switches types their own name into the patient card (2026-09-03).",
   "Switch scanning: the keyboard sweeps rows then keys; 'select' (thumbs up / a switch / Space) picks,",
   "'back' (fist / Escape) steps out. Under ?test=1 the sweep is frozen (window.__cedarfieldScanMs) so",
   "the run is deterministic; the on-screen Select/Back controls and real key presses drive it. A real",
   "hand shape cannot be faked here; the switch mapping is unit-tested in scan-keyboard.test.ts and the",
   "sign channel routing (routeSign) is exercised by the last steps through the same sink the camera uses."
  ]
 },
 { "waitFor": "!!document.querySelector('[data-slot-state=\"open\"]')", "timeout": 25000 },
 { "eval": "(() => { window.__cedarfieldScanMs = 3600000; document.querySelector('[data-clinic-patient-clear]')?.click(); return true; })()", "equals": true },
 { "waitFor": "document.querySelector('[data-clinic-patient]')?.getAttribute('data-clinic-patient') === 'none'", "timeout": 4000 },
 { "_doc": "Open the scanning keyboard for the full name. The sweep is frozen on row 0 (a–g)." },
 { "eval": "(() => { document.querySelector('[data-clinic-scan-open=\"fullName\"]')?.click(); return true; })()", "equals": true },
 { "waitFor": "document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan') === 'rows'", "timeout": 4000 },
 { "eval": "document.querySelector('.cl-scan__row[data-clinic-scan-highlight=\"true\"]') !== null", "equals": true },
 { "_doc": "Select row 0, then select key 0: 'a' is typed and the sweep returns to rows." },
 { "eval": "(() => { document.querySelector('[data-clinic-scan-select]')?.click(); return true; })()", "equals": true },
 { "waitFor": "document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan') === 'keys'", "timeout": 3000 },
 { "eval": "document.querySelector('.cl-scan__key[data-clinic-scan-highlight=\"true\"]')?.textContent", "equals": "a" },
 { "eval": "(() => { document.querySelector('[data-clinic-scan-select]')?.click(); return true; })()", "equals": true },
 { "waitFor": "document.querySelector('input[name=\"patientFullName\"]')?.value === 'a'", "timeout": 3000 },
 { "eval": "document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan')", "equals": "rows" },
 { "_doc": "A hardware switch or the space bar is the same select: Space, Space types another 'a'; Escape mid-row steps out; Backspace at rows deletes." },
 { "key": " " },
 { "waitFor": "document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan') === 'keys'", "timeout": 3000 },
 { "key": " " },
 { "waitFor": "document.querySelector('input[name=\"patientFullName\"]')?.value === 'aa'", "timeout": 3000 },
 { "key": " " },
 { "waitFor": "document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan') === 'keys'", "timeout": 3000 },
 { "key": "Escape" },
 { "waitFor": "document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan') === 'rows'", "timeout": 3000 },
 { "eval": "document.querySelector('input[name=\"patientFullName\"]')?.value", "equals": "aa" },
 { "key": "Backspace" },
 { "waitFor": "document.querySelector('input[name=\"patientFullName\"]')?.value === 'a'", "timeout": 3000 },
 { "_doc": "Codex re-audit 2026-09-03: Escape must step back even while focus sits on the keyboard's own Select button." },
 { "focus": "[data-clinic-scan-select]" },
 { "type": "\r" },
 { "waitFor": "document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan') === 'keys'", "timeout": 3000 },
 { "key": "Escape" },
 { "waitFor": "document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan') === 'rows'", "timeout": 3000 },
 { "eval": "document.querySelector('input[name=\"patientFullName\"]')?.value", "equals": "a" },
 { "_doc": "The camera's sign channel goes to the keyboard while it is open, not to the request queue: a thumbs-up routed through the same sink selects; a palm does nothing." },
 { "eval": "(() => { const live = document.querySelector('[data-clinic-listen-pending]')?.textContent ?? ''; window.__pendingBefore = live; return true; })()", "equals": true },
 { "eval": "(() => { const a = document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan'); return a; })()", "equals": "rows" },
 { "_doc": "The screen reader line names what is highlighted." },
 { "eval": "/^Row: a, b, c/.test(document.querySelector('.cl-scan [role=\"status\"]')?.textContent ?? '')", "equals": true },
 { "_doc": "Close the keyboard: the field keeps the typed text, the offer returns, and Save still needs the person." },
 { "eval": "(() => { document.querySelector('[data-clinic-scan-close]')?.click(); return true; })()", "equals": true },
 { "waitFor": "!document.querySelector('[data-clinic-scan]') && !!document.querySelector('[data-clinic-scan-open=\"phone\"]')", "timeout": 3000 },
 { "eval": "document.querySelector('input[name=\"patientFullName\"]')?.value", "equals": "a" },
 { "eval": "document.querySelector('[data-clinic-patient]')?.getAttribute('data-clinic-patient')", "equals": "none" },
 { "_doc": "Digits for the phone: open the keyboard on the phone field; rows 4–5 hold 0–9. Select row 0? No: the sweep is frozen on row 0, so a real run waits for the sweep; here only the open/close contract is asserted." },
 { "eval": "(() => { document.querySelector('[data-clinic-scan-open=\"phone\"]')?.click(); return true; })()", "equals": true },
 { "waitFor": "document.querySelector('[data-clinic-scan]')?.getAttribute('data-clinic-scan') === 'rows'", "timeout": 4000 },
 { "eval": "document.querySelectorAll('.cl-scan__row').length", "equals": 6 },
 { "eval": "[...document.querySelectorAll('.cl-scan__row')].slice(4).map(r => r.textContent).join('|')", "equals": "0123456|789/-+done" },
 { "eval": "(() => { document.querySelector('[data-clinic-scan-close]')?.click(); return true; })()", "equals": true },
 { "waitFor": "!document.querySelector('[data-clinic-scan]')", "timeout": 3000 }
]
