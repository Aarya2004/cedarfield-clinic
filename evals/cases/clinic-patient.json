[
  {"_doc": ["clinic-patient — who the appointment is for (Codex audit, 2026-09-02).",
            "Start from nobody on file (Not you? Remove). Saving with a bad date shows an alert AND a field-level",
            "error, marks the field invalid and focuses it; the fields are required. A typed day-first date is",
            "accepted and normalised; a durable 'Saved' status appears; 'Booking as' shows the name. The grant",
            "control refuses without a patient and says so at the top; with one, it grants."]},
  {"waitFor": "document.querySelector('[data-clinic-route=\"book\"]') !== null", "timeout": 20000},
  {"waitFor": "document.querySelector('[data-clinic-patient]')?.getAttribute('data-clinic-patient') === 'on-file'", "timeout": 8000},
  {"eval": "(() => { document.querySelector('[data-clinic-patient-clear]')?.click(); return true; })()", "equals": true},
  {"waitFor": "document.querySelector('[data-clinic-patient]')?.getAttribute('data-clinic-patient') === 'none'", "timeout": 4000},
  {"eval": "[...document.querySelectorAll('[data-clinic-patient-form] input')].every(i => i.required)", "equals": true},

  {"_doc": "No patient: the grant control refuses with a reason at the top, and no permission is created."},
  {"focus": "[data-clinic-delegate]"},
  {"type": "\r"},
  {"waitFor": "!!document.querySelector('[data-clinic-notice]')", "timeout": 4000},
  {"eval": "(document.querySelector('[data-clinic-notice]')?.textContent ?? '')", "matches": "name, date of birth and phone"},
  {"eval": "document.querySelector('[data-clinic-delegation]')?.getAttribute('data-clinic-delegation')", "equals": "none"},

  {"_doc": "A bad date: alert + field error + invalid marking; nothing saved."},
  {"focus": "#cl-patient-name"},
  {"type": "Rosa Lindqvist"},
  {"focus": "#cl-patient-dob"},
  {"type": "31/13/1990"},
  {"focus": "#cl-patient-phone"},
  {"type": "6135550147"},
  {"focus": "[data-clinic-patient-save]"},
  {"type": "\r"},
  {"waitFor": "!!document.querySelector('[data-clinic-patient-error]')", "timeout": 4000},
  {"eval": "(document.querySelector('[data-clinic-patient-error]')?.textContent ?? '')", "matches": "One field needs attention"},
  {"eval": "document.querySelector('#cl-patient-dob')?.getAttribute('aria-invalid')", "equals": "true"},
  {"eval": "(document.querySelector('#cl-patient-dob-error')?.textContent ?? '')", "matches": "does not exist"},
  {"eval": "document.activeElement?.id", "equals": "cl-patient-dob"},
  {"eval": "document.querySelector('[data-clinic-patient]')?.getAttribute('data-clinic-patient')", "equals": "none"},

  {"_doc": "A real day-first date is accepted and normalised; a durable Saved status appears."},
  {"eval": "(() => { const i = document.querySelector('#cl-patient-dob'); Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(i, ''); i.dispatchEvent(new Event('input', { bubbles: true })); i.focus(); return i.value; })()", "equals": ""},
  {"type": "12/04/1990"},
  {"focus": "[data-clinic-patient-save]"},
  {"type": "\r"},
  {"waitFor": "document.querySelector('[data-clinic-patient]')?.getAttribute('data-clinic-patient') === 'on-file'", "timeout": 4000},
  {"eval": "(document.querySelector('[data-clinic-patient-name]')?.textContent ?? '')", "equals": "Rosa Lindqvist"},
  {"eval": "(document.querySelector('[data-clinic-patient-saved]')?.textContent ?? '')", "matches": "Saved"},
  {"eval": "(document.querySelector('[data-clinic-patient] .cl-patient__line')?.textContent ?? '')", "matches": "Apr.*1990"},
  {"eval": "JSON.parse(localStorage.getItem('cedarfield.patient') ?? '{}').dateOfBirth", "equals": "1990-04-12"},

  {"_doc": "With a patient on file, the same press grants."},
  {"focus": "[data-clinic-delegate]"},
  {"type": "\r"},
  {"waitFor": "document.querySelector('[data-clinic-delegation]')?.getAttribute('data-clinic-delegation') === 'granted'", "timeout": 4000},
  {"shot": "docs/evidence/clinic/patient-on-file.png"}
]
