[
  {"_doc": ["clinic-path — the primary path is the page's own state (2026-09-02).",
            "Ask → It holds a time → You confirm, at the top, tracking the board: 'ask' at load, 'confirm' the",
            "moment a hold lands (the person's step), 'booked' after the press, and 'confirm' again naming the",
            "act when a cancel is armed."]},
  {"waitFor": "document.querySelector('[data-clinic-route=\"book\"]') !== null", "timeout": 20000},
  {"waitFor": "document.querySelector('[data-clinic-tools]')?.getAttribute('data-clinic-tools') === 'registered'", "timeout": 15000},
  {"eval": "document.querySelector('[data-clinic-path]')?.getAttribute('data-clinic-path')", "equals": "ask"},
  {"eval": "document.querySelectorAll('[data-clinic-path-step=\"now\"]').length", "equals": 1},
  {"waitFor": "!!document.querySelector('[data-slot-state=\"open\"]')", "timeout": 20000},
  {"eval": "(() => { const el = document.querySelector('[data-slot-state=\"open\"]'); window.__p = el && el.getAttribute('data-clinic-slot'); return typeof window.__p; })()", "equals": "string"},
  {"invoke": "clinic_hold_slot", "inputFrom": {"slot_id": "window.__p"}, "outputMatches": "held.{0,2}:true"},
  {"waitFor": "document.querySelector('[data-clinic-path]')?.getAttribute('data-clinic-path') === 'confirm'", "timeout": 8000},
  {"eval": "(document.querySelector('[data-clinic-path-step=\"now\"] .cl-path__title')?.textContent ?? '')", "matches": "You confirm"},
  {"waitFor": "document.querySelector('[data-armed]')?.getAttribute('data-armed') === 'true'", "timeout": 8000},
  {"focus": "[data-armed] button"},
  {"key": "Enter"},
  {"waitFor": "document.querySelector('[data-clinic-path]')?.getAttribute('data-clinic-path') === 'booked'", "timeout": 8000},
  {"eval": "(document.querySelector('[data-clinic-path-step=\"booked\"] .cl-path__title')?.textContent ?? '')", "equals": "Booked"},
  {"invoke": "clinic_prepare_cancel", "outputMatches": "armed.{0,4}:.{0,3}cancel"},
  {"waitFor": "document.querySelector('[data-clinic-path]')?.getAttribute('data-clinic-path') === 'confirm'", "timeout": 8000},
  {"eval": "(document.querySelector('[data-clinic-path-step=\"now\"] .cl-path__title')?.textContent ?? '')", "matches": "You confirm the cancel"},
  {"shot": "docs/evidence/clinic/path-strip.png"}
]
