[
  {"_doc": ["clinic-delegation — SPEC-V9: THE BOOKING TOOL IS BORN BY YOUR HAND.",
            "At load there is no clinic_book_slot and calling it is impossible. A synthetic click on the",
            "permission control is counted and ignored. One TRUSTED press (CDP key event) grants one booking",
            "for ten minutes: the tool is born (toolchange), the agent books on 'yes', the page records it",
            "as 0 interactions under the permission, the grant is spent and the tool dies."]},
  {"waitFor": "document.querySelector('[data-clinic-route=\"book\"]') !== null", "timeout": 20000},
  {"waitFor": "document.querySelector('[data-clinic-tools]')?.getAttribute('data-clinic-tools') === 'registered'", "timeout": 15000},
  {"list": true},
  {"expect": {"noTool": "clinic_book_slot"}},
  {"eval": "document.querySelector('[data-clinic-tool-count]')?.getAttribute('data-clinic-tool-count')", "equals": "9"},
  {"eval": "document.querySelector('[data-clinic-delegation]')?.getAttribute('data-clinic-delegation')", "equals": "none"},

  {"_doc": "A synthetic click is not a grant."},
  {"eval": "(() => { document.querySelector('[data-clinic-delegate]')?.click(); return true; })()", "equals": true},
  {"sleep": 300},
  {"eval": "document.querySelector('[data-clinic-delegation]')?.getAttribute('data-clinic-delegation')", "equals": "none"},
  {"eval": "Number(document.querySelector('[data-clinic-synthetic-grants]')?.getAttribute('data-clinic-synthetic-grants'))", "equals": 1},
  {"expect": {"noTool": "clinic_book_slot"}},

  {"_doc": "A trusted press grants: the tool is born."},
  {"focus": "[data-clinic-delegate]"},
  {"type": "\r"},
  {"waitFor": "document.querySelector('[data-clinic-delegation]')?.getAttribute('data-clinic-delegation') === 'granted'", "timeout": 4000},
  {"waitFor": "document.querySelector('[data-clinic-tool-count]')?.getAttribute('data-clinic-tool-count') === '10'", "timeout": 8000},
  {"list": true},
  {"expect": {"tool": "clinic_book_slot"}},
  {"invoke": "clinic_explain_confirm", "outputMatches": "tool_that_books.{0,4}:.{0,3}clinic_book_slot"},
  {"shot": "docs/evidence/clinic/delegation-granted.png"},

  {"_doc": "The agent books on 'yes'."},
  {"waitFor": "!!document.querySelector('[data-slot-state=\"open\"]')", "timeout": 20000},
  {"eval": "(() => { const el = document.querySelector('[data-slot-state=\"open\"]'); window.__d = el && el.getAttribute('data-clinic-slot'); return typeof window.__d; })()", "equals": "string"},
  {"invoke": "clinic_book_slot", "inputFrom": {"slot_id": "window.__d"}, "outputMatches": "booked.{0,2}:true[\\s\\S]*under_permission_granted_at"},
  {"waitFor": "document.querySelector('[data-clinic-slot=\"' + window.__d + '\"]')?.getAttribute('data-slot-state') === 'booked_yours'", "timeout": 8000},
  {"waitFor": "!!document.querySelector('[data-clinic-appointment]')", "timeout": 8000},
  {"eval": "(() => { const c = document.querySelector('[data-clinic-appointment]'); return c ? c.getAttribute('data-clinic-booked-under-permission') + ':' + c.getAttribute('data-clinic-cost-agent') : null; })()", "equals": "true:0"},
  {"eval": "(document.querySelector('[data-clinic-appointment] [data-lane=\"agent\"]')?.textContent ?? '')", "matches": "under the permission you gave — 0 interactions from you"},
  {"eval": "(document.querySelector('[data-clinic-call=\"ok\"]')?.textContent ?? '')", "matches": "booked .* with .* under the permission you gave"},

  {"_doc": "The grant is spent: the booking tool dies; the born-by-booking tool lives."},
  {"waitFor": "document.querySelector('[data-clinic-delegation]')?.getAttribute('data-clinic-delegation') === 'none'", "timeout": 4000},
  {"waitFor": "!(document.querySelector('[data-clinic-tools]')?.getAttribute('data-clinic-tools-live') ?? '').includes('clinic_book_slot')", "timeout": 8000},
  {"list": true},
  {"expect": {"noTool": "clinic_book_slot"}},
  {"expect": {"tool": "clinic_my_appointment"}},
  {"eval": "document.querySelector('[data-clinic-tool-count]')?.getAttribute('data-clinic-tool-count')", "equals": "10"},
  {"shot": "docs/evidence/clinic/delegation-spent.png"}
]
