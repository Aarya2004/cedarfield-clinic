[
 {
  "_doc": [
   "clinic-delegation-edges \u2014 the permission protocol under pressure (Codex audit, 2026-09-02).",
   "Expiry: a grant shortened to 3 s (test hook) dies on its own and the booking tool with it.",
   "Revoke: 'Take that back' ends it at once. Wrong slot / taken slot: the tool refuses and the grant",
   "stands. Replay after spend: the tool is gone. No patient: the press itself is refused. Reload:",
   "nothing persists (a fresh page starts with no grant)."
  ]
 },
 {
  "waitFor": "document.querySelector('[data-clinic-route=\"book\"]') !== null",
  "timeout": 20000
 },
 {
  "waitFor": "document.querySelector('[data-clinic-tools]')?.getAttribute('data-clinic-tools') === 'registered'",
  "timeout": 15000
 },
 {
  "waitFor": "document.querySelector('[data-clinic-patient]')?.getAttribute('data-clinic-patient') === 'on-file'",
  "timeout": 8000
 },
 {
  "_doc": "Expiry in seconds (test hook, honoured only under ?test=1)."
 },
 {
  "eval": "(() => { window.__cedarfieldDelegationMs = 3000; return true; })()",
  "equals": true
 },
 {
  "focus": "[data-clinic-delegate]"
 },
 {
  "type": "\r"
 },
 {
