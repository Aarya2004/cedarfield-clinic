  "timeout": 8000
 },
 {
  "waitFor": "document.querySelector('[data-clinic-delegation]')?.getAttribute('data-clinic-delegation') === 'none'",
  "timeout": 8000
 },
 {
  "waitFor": "!(document.querySelector('[data-clinic-tools]')?.getAttribute('data-clinic-tools-live') ?? '').includes('clinic_book_slot')",
  "timeout": 8000
 },
 {
  "eval": "(() => { delete window.__cedarfieldDelegationMs; return true; })()",
  "equals": true
 },
 {
  "_doc": "Revoke ends a grant at once."
 },
 {
  "focus": "[data-clinic-delegate]"
 },
 {
  "type": "\r"
 },
 {
  "waitFor": "document.querySelector('[data-clinic-delegation]')?.getAttribute('data-clinic-delegation') === 'granted'",
