[
 {
  "_doc": [
   "clinic-ask — the other half of the turn (2026-09-03): the agent asks ONE bounded question through the page",
   "and the person answers any way they can — a button, the typed line, a spoken sentence, a hand shape's phrase.",
   "The harness starts the call without waiting (invokeAsync) so the page can be driven while it is open.",
   "A real microphone cannot be driven headlessly; the ?test=1 seam window.__cedarfieldHear(text) delivers a",
   "final sentence exactly where the recognizer would. Proves: the card, label/ordinal/yes answers, the answer is",
   "never queued, an unrelated sentence still queues, the button, stop, timeout, supersede, and input validation."
  ]
 },
 { "waitFor": "!!document.querySelector('[data-slot-state=\"open\"]')", "timeout": 25000 },
 { "waitFor": "typeof window.__cedarfieldHear === 'function'", "timeout": 8000 },
 { "_doc": "Validation: one choice, four choices, an empty question — refused with the reason." },
 { "invoke": "clinic_ask", "input": { "question": "Hold it?", "choices": ["Yes"] }, "outputMatches": "choices_required" },
 { "invoke": "clinic_ask", "input": { "question": "Hold it?", "choices": ["a", "b", "c", "d"] }, "outputMatches": "choices_required" },
 { "invoke": "clinic_ask", "input": { "question": "", "choices": ["Hold it", "No"] }, "outputMatches": "question_required" },
 { "eval": "document.querySelector('[data-clinic-ask]') === null", "equals": true },
 { "_doc": "1. A spoken ordinal answers; an unrelated sentence meanwhile is queued as a request, not an answer." },
 { "invokeAsync": "clinic_ask", "as": "ask1", "input": { "question": "Hold 10:30 with Dr Lin?", "choices": ["Hold it", "Show another time"], "timeout_seconds": 30 } },
 { "waitFor": "document.querySelector('[data-clinic-ask]')?.getAttribute('data-clinic-ask') === '2'", "timeout": 4000 },
 { "eval": "document.querySelector('[data-clinic-ask-question]')?.textContent", "equals": "Hold 10:30 with Dr Lin?" },
 { "eval": "[...document.querySelectorAll('[data-clinic-ask-choice]')].map(b => b.textContent).join('|')", "equals": "Hold it|Show another time" },
 { "eval": "(() => { window.__cedarfieldHear('is Dr Rao available on Tuesday?'); return true; })()", "equals": true },
 { "waitFor": "Number(document.querySelector('[data-clinic-listen]')?.getAttribute('data-clinic-listen-pending') ?? 0) === 1", "timeout": 4000 },
 { "eval": "document.querySelector('[data-clinic-ask]') !== null", "equals": true },
 { "eval": "(() => { window.__cedarfieldHear('the first one'); return true; })()", "equals": true },
 { "awaitInvoke": "ask1", "timeout": 6000, "outputMatches": "index.{0,4}:.{0,3}0.*label.{0,4}:.{0,4}Hold it.*via.{0,4}:.{0,4}voice" },
 { "waitFor": "document.querySelector('[data-clinic-ask]') === null", "timeout": 3000 },
 { "eval": "Number(document.querySelector('[data-clinic-listen]')?.getAttribute('data-clinic-listen-pending') ?? 0)", "equals": 1 },
 { "eval": "document.querySelector('[data-clinic-heard=\"voice\"]')?.textContent?.includes('the first one')", "equals": true },
 { "invoke": "clinic_wait_for_request", "input": { "timeout_seconds": 5 }, "outputMatches": "Tuesday" },
 { "_doc": "2. The card's own button answers (keyboard, switch, head pointer) — via 'button'." },
 { "invokeAsync": "clinic_ask", "as": "ask2", "input": { "question": "Which part of the day?", "choices": ["Morning", "Afternoon", "Evening"], "timeout_seconds": 30 } },
 { "waitFor": "document.querySelector('[data-clinic-ask]')?.getAttribute('data-clinic-ask') === '3'", "timeout": 4000 },
 { "focus": "[data-clinic-ask-choice=\"2\"]" },
 { "type": "\r" },
 { "awaitInvoke": "ask2", "timeout": 6000, "outputMatches": "index.{0,4}:.{0,3}2.*Evening.*via.{0,4}:.{0,4}button" },
 { "_doc": "3. A spoken yes is the first choice; the sign phrase 'another one' is the second." },
 { "invokeAsync": "clinic_ask", "as": "ask3", "input": { "question": "Hold 10:30?", "choices": ["Hold it", "Show another time"], "timeout_seconds": 30 } },
 { "waitFor": "!!document.querySelector('[data-clinic-ask]')", "timeout": 4000 },
 { "eval": "(() => { window.__cedarfieldHear('another one'); return true; })()", "equals": true },
 { "awaitInvoke": "ask3", "timeout": 6000, "outputMatches": "index.{0,4}:.{0,3}1.*Show another time" },
 { "invokeAsync": "clinic_ask", "as": "ask4", "input": { "question": "Hold 10:30?", "choices": ["Hold it", "Show another time"], "timeout_seconds": 30 } },
 { "waitFor": "!!document.querySelector('[data-clinic-ask]')", "timeout": 4000 },
 { "eval": "(() => { window.__cedarfieldHear('yes please'); return true; })()", "equals": true },
 { "awaitInvoke": "ask4", "timeout": 6000, "outputMatches": "index.{0,4}:.{0,3}0.*Hold it" },
 { "_doc": "4. Stop ends it; a timeout answers null with the seconds waited; a newer question supersedes an older one." },
 { "invokeAsync": "clinic_ask", "as": "ask5", "input": { "question": "Keep looking?", "choices": ["Yes", "No"], "timeout_seconds": 30 } },
 { "waitFor": "!!document.querySelector('[data-clinic-ask-stop]')", "timeout": 4000 },
 { "focus": "[data-clinic-ask-stop]" },
 { "type": "\r" },
 { "awaitInvoke": "ask5", "timeout": 6000, "outputMatches": "stopped.{0,4}:.{0,3}true" },
 { "invokeAsync": "clinic_ask", "as": "ask6", "input": { "question": "Still there?", "choices": ["Yes", "No"], "timeout_seconds": 2 } },
 { "awaitInvoke": "ask6", "timeout": 8000, "outputMatches": "answer.{0,4}:.{0,3}null.*waited_seconds" },
 { "invokeAsync": "clinic_ask", "as": "ask7", "input": { "question": "First?", "choices": ["A", "B"], "timeout_seconds": 30 } },
 { "waitFor": "document.querySelector('[data-clinic-ask-question]')?.textContent === 'First?'", "timeout": 4000 },
 { "invokeAsync": "clinic_ask", "as": "ask8", "input": { "question": "Second?", "choices": ["C", "D"], "timeout_seconds": 30 } },
 { "waitFor": "document.querySelector('[data-clinic-ask-question]')?.textContent === 'Second?'", "timeout": 4000 },
 { "awaitInvoke": "ask7", "timeout": 6000, "outputMatches": "answer.{0,4}:.{0,3}null" },
 { "focus": "[data-clinic-ask-choice=\"1\"]" },
 { "type": "\r" },
 { "awaitInvoke": "ask8", "timeout": 6000, "outputMatches": "index.{0,4}:.{0,3}1.*label.{0,4}:.{0,4}D" },
 { "_doc": "The record on the page carries every ask in the person's words." },
 { "waitFor": "/asked you/.test(document.querySelector('[data-clinic-agent-log]')?.textContent ?? '')", "timeout": 4000 }
]
